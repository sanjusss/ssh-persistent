# `ssh-mux` 主机配置示例。以下地址、用户名和密码需要替换为实际信息。
# 默认配置路径：~/.config/ssh-mux/hosts.conf
# 可用环境变量 `SSH_MUX_CONFIG` 指定其他路径。
# 建议通过 `ssh-mux.sh host add` 和 `host remove` 增删主机
# （`Windows` 没有 `bash` 时改用 `ssh-mux.bat`）。
#
# 每台主机占一个 [别名] 段，执行命令时使用这个别名。
#   `host`      主机 IP 或域名，必填。
#   `port`      SSH 端口，默认 22。
#   `user`      登录用户名，默认取本机 `USER` 环境变量；取不到时使用 `root`。
#   `password`  登录密码，以明文保存；不配置时使用密钥认证。
#   `via`       通过哪台主机登录，填写本文件中已配置的主机别名。
#   `via_mode`  `jump`：直连或支持 `ssh -J` 的标准跳板机，默认使用此模式。
#               `shell`：通过堡垒机的交互式终端登录。
#   `routing`   在堡垒机上填写 `username`，表示通过登录名指定目标 IP。
#               脚本使用 `<user>/<目标IP>/any` 作为登录名，先填写堡垒机密码，
#               再根据目标机的提示填写用户名和密码。
#   `staging`   暂存主机的别名，仅用于 [local] 段。
#
# 逐段代理字段（都可省略；某主机的代理字段控制“上一节点 → 该主机”这一段）：
#   `proxy`           `http` 或 `socks5`；填写 `direct` 表示显式直连，
#                     并忽略同段其余 `proxy_*` 字段和 `SSH_MUX_PROXY`。
#   `proxy_host`      代理地址；相对于段起点解析，可以是域名或 IP。
#   `proxy_port`      代理端口，1-65535。
#   `proxy_user`      代理认证用户名，可省略；HTTP 用户名不能含冒号。
#   `proxy_password`  代理认证密码，可省略；只写密码不写用户名会被拒绝。
# 没有配置任何代理字段时，只有从本机出发的第一段读取环境变量
# `SSH_MUX_PROXY`（格式 `http://主机:端口` 或 `socks5://主机:端口`，不含用户名），
# 后续各段默认直连。代理不会沿登录链继承或串联。
# 用户名路由堡垒机作为入口时，入口段使用堡垒机的代理配置；
# 目标主机上的代理配置对该入口段不生效，请写在堡垒机上。
#
# `shell` 模式传输文件需要 [local]；`jump` 模式不需要。
# 如果本机运行了 `sshd`（接收 SSH 登录的服务），按下面填写本机信息。
# 地址必须能被中转主机访问，不能填写 127.0.0.1。
[local]
host=1.1.1.1
user=myuser
password=mypass

# 如果本机没有运行 `sshd`，用下面的配置替换上面的 [local] 段。
# 文件先传到暂存主机，再由接收方下载。
# 本机和连接路径上的第一台中转主机都必须能通过 SSH 登录暂存主机。
# 暂存主机必须使用 `jump` 模式，并配置 `password`。
# 使用 `staging` 后，[local] 的 `host`、`user`、`password` 可以省略。
# [local]
# staging=jump

# 堡垒机：通过 `<账号>/<目标IP>/any` 格式的登录名选择目标服务器。
# 本机到堡垒机这一段需要经过 HTTP 代理时，代理配置写在堡垒机上。
[bastion]
host=2.2.2.2
user=T123456
password=jump-pass
routing=username
# proxy=http
# proxy_host=proxy.corp.example
# proxy_port=8080
# proxy_user=proxy-account
# proxy_password=proxy-pass

# 目标主机 `A`：通过 `bastion` 登录。
# 堡垒机直接转到目标，入口段不使用这里的代理字段。
[A]
host=3.3.3.3
user=root
password=a-pass
via=bastion
via_mode=shell

# 目标主机 `B`：先登录 `A`，再从 `A` 登录 `B`。
# 传输文件时，`A` 也需要能通过 `scp` 访问 `B`。
# 下面三行让 `A` 到 `B` 这一段经过 `SOCKS5` 代理（代理地址由 `A` 解析）。
# 该段在 `A` 上准备代理程序，`A` 需要 Python 3.4 或更新版本。
[B]
host=4.4.4.4
user=root
password=b-pass
via=A
via_mode=shell
# proxy=socks5
# proxy_host=10.1.1.1
# proxy_port=1080

# 标准 SSH 跳板机：支持 `ssh -J`。
[jump]
host=5.5.5.5
port=2222
user=jump
password=jump-pass

# 目标主机 `web`：通过 `jump` 登录。
# `jump` 到 `web` 这一段需要代理时，代理配置写在 `web` 上；
# 本机辅助程序复用 `jump` 的连接访问代理完成握手，`jump` 上无需 Python。
[web]
host=6.6.6.6
user=root
password=web-pass
via=jump
via_mode=jump
# proxy=http
# proxy_host=10.2.2.2
# proxy_port=8080

# 直连主机 `db`：不填写 `via`，自动使用 `jump` 模式。
# `proxy=direct` 表示显式直连：忽略 `SSH_MUX_PROXY` 和同段残留的 `proxy_*` 字段。
[db]
host=7.7.7.7
user=root
password=db-pass
# proxy=direct
