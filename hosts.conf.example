# `ssh-mux` 主机配置示例。以下地址、用户名和密码需要替换为实际信息。
# 默认配置路径：~/.config/ssh-mux/hosts.conf
# 可用环境变量 `SSH_MUX_CONFIG` 指定其他路径。
# 建议通过 `python3 ssh-mux.py host add` 和 `host remove` 增删主机。
#
# 每台主机占一个 [别名] 段，执行命令时使用这个别名。
#   `host`      主机 IP 或域名，必填。
#   `port`      SSH 端口，默认 22。
#   `user`      登录用户名，默认使用本机当前用户。
#   `password`  登录密码，以明文保存；不配置时使用密钥认证。
#   `via`       通过哪台主机登录，填写本文件中已配置的主机别名。
#   `via_mode`  `jump`：直连或支持 `ssh -J` 的标准跳板机，默认使用此模式。
#               `shell`：通过堡垒机的交互式终端登录。
#   `routing`   在堡垒机上填写 `username`，表示通过登录名指定目标 IP。
#               脚本使用 `<user>/<目标IP>/any` 作为登录名，先填写堡垒机密码，
#               再根据目标机的提示填写用户名和密码。
#   `staging`   暂存主机的别名，仅用于 [local] 段。
#
# `shell` 模式传输文件需要 [local]；`jump` 模式不需要。
# 如果本机运行了 `sshd`（接收 SSH 登录的服务），按下面填写本机信息。
# 地址必须能被中转主机访问，不能填写 127.0.0.1。
[local]
host=1.1.1.1
user=myuser
password=mypass

# 如果本机没有运行 `sshd`，用下面的配置替换上面的 [local] 段。
# 文件先传到暂存主机，再由接收方下载。
# 本机和连接路径上的第一台中转主机都必须能通过 SSH 登录暂存主机。
# 暂存主机必须使用 `jump` 模式，并配置 `password`。
# 使用 `staging` 后，[local] 的 `host`、`user`、`password` 可以省略。
# [local]
# staging=jump

# 堡垒机：通过 `<账号>/<目标IP>/any` 格式的登录名选择目标服务器。
[bastion]
host=2.2.2.2
user=T123456
password=jump-pass
routing=username

# 目标主机 `A`：通过 `bastion` 登录。
[A]
host=3.3.3.3
user=root
password=a-pass
via=bastion
via_mode=shell

# 目标主机 `B`：先登录 `A`，再从 `A` 登录 `B`。
# 传输文件时，`A` 也需要能通过 `scp` 访问 `B`。
[B]
host=4.4.4.4
user=root
password=b-pass
via=A
via_mode=shell

# 标准 SSH 跳板机：支持 `ssh -J`。
[jump]
host=5.5.5.5
port=2222
user=jump
password=jump-pass

# 目标主机 `web`：通过 `jump` 登录。
[web]
host=6.6.6.6
user=root
password=web-pass
via=jump
via_mode=jump

# 直连主机 `db`：不填写 `via`，自动使用 `jump` 模式。
[db]
host=7.7.7.7
user=root
password=db-pass
